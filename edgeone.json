{
  "name": "likegirl-ce",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22.21.1",
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/Style/*",
      "headers": [
        { "key": "Cache-Control", "value": "public,max-age=604800" }
      ]
    }
  ],
  "cloudFunctions": {
    "maxDuration": 30
  }
}
